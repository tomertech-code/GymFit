        justify-content: center;
        font-size: 0.95rem;
        color: var(--gold);
        transition: transform var(--transition-fast);
    }

    .quick-action-card:hover .qa-icon {
        transform: scale(1.1);
    }

    /* ========== RESPONSIVE ========== */
    @@media (max-width: 575.98px) {
        .dashboard-section {
            padding-top: 1.25rem;
        }

        .stat-card-inner {
            padding: 0.95rem 0.85rem;
            gap: 0.65rem;
        }

        .stat-icon-wrap {
            width: 36px;
            height: 36px;
            font-size: 0.9rem;
        }

        .stat-value {
            font-size: 1.25rem;
        }

        .btn-export {
            width: 100%;
            justify-content: center;
        }

        .chart-wrapper {
            height: 260px;
        }
    }

    @@media (min-width: 1200px) {
        .col-xl-2 {
            flex: 0 0 auto;
            width: 16.666%;
        }
    }
</style>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        let revenueChart;
        const prefersReducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        $(document).ready(function() {
            setGreetingAndDate();
            loadDashboardStats();
        });

        function setGreetingAndDate() {
            const now = new Date();
            const hour = now.getHours();
            let greeting = 'Good Morning';
            if (hour >= 12 && hour < 17) greeting = 'Good Afternoon';
            else if (hour >= 17) greeting = 'Good Evening';

            $('#greeting').text(greeting);

            const options = { weekday: 'long', year: 'numeric', month: 'long', day: 'numeric' };
            $('#currentDate').text(now.toLocaleDateString(undefined, options));
        }

        function animateCounter(el, endValue, prefix, duration) {
            if (prefersReducedMotion) {
                el.textContent = prefix + endValue.toLocaleString(undefined, { maximumFractionDigits: 0 });
                return;
            }

            const start = 0;
            const startTime = performance.now();
            const isCurrency = prefix === '$';

            function update(currentTime) {
                const elapsed = currentTime - startTime;
                const progress = Math.min(elapsed / duration, 1);
                // Ease-out cubic
                const eased = 1 - Math.pow(1 - progress, 3);
                const current = Math.floor(start + (endValue - start) * eased);

                el.textContent = prefix + current.toLocaleString(undefined, { maximumFractionDigits: 0 });

                if (progress < 1) {
                    requestAnimationFrame(update);
                } else {
                    el.textContent = prefix + endValue.toLocaleString(undefined, { maximumFractionDigits: 0 });
                }
            }

            requestAnimationFrame(update);
        }

        function getInitials(name) {
            if (!name || typeof name !== 'string') return '?';
            const parts = name.trim().split(/\s+/).filter(Boolean);
            if (parts.length === 0) return '?';
            if (parts.length === 1) return parts[0].charAt(0).toUpperCase();
            return (parts[0].charAt(0) + parts[parts.length - 1].charAt(0)).toUpperCase();
        }

        function loadDashboardStats() {
            ajaxHelper.get('/AdminDashboard/GetStats', function(data) {
                // --- Stats with animated counters ---
                const totalMembers = data.totalMembers || 0;
                const activeMembers = data.activeMembers || 0;
                const todayAttendance = data.todayAttendance || 0;
                const monthlyRevenue = data.monthlyRevenue || 0;
                const expiredMemberships = data.expiredMemberships || 0;
                const todayEnquiries = data.todayEnquiries || 0;

                // Clear skeletons and animate
                animateCounter(document.getElementById('totalMembers'), totalMembers, '', 900);
                animateCounter(document.getElementById('activeMembers'), activeMembers, '', 950);
                animateCounter(document.getElementById('todayAttendance'), todayAttendance, '', 1000);
                animateCounter(document.getElementById('monthlyRevenue'), monthlyRevenue, '$', 1100);
                animateCounter(document.getElementById('expiredMemberships'), expiredMemberships, '', 1050);
                animateCounter(document.getElementById('todayEnquiries'), todayEnquiries, '', 1000);

                // Overview cards (reuse same data)
                $('#overviewTotal').text(totalMembers.toLocaleString());
                $('#overviewActive').text(activeMembers.toLocaleString());
                $('#overviewExpired').text(expiredMemberships.toLocaleString());
                $('#overviewAttendance').text(todayAttendance.toLocaleString());
                $('#overviewEnquiries').text(todayEnquiries.toLocaleString());

                // --- Recent Members ---
                let membersList = '';
                if (!data.recentMembers || data.recentMembers.length === 0) {
                    membersList = `
                                <li class="list-group-item text-center py-5">
                                    <i class="fas fa-user-slash fa-2x text-white-50 mb-3 d-block"></i>
                                    <p class="text-white-60 mb-0">No recent sign-ups</p>
                                </li>`;
                } else {
                    data.recentMembers.forEach(function(member, index) {
                        const name = escapeHtml(member.name || 'Unknown');
                        const plan = escapeHtml(member.plan || 'Standard');
                        const joinDate = escapeHtml(member.joinDate || 'Today');
                        const initials = getInitials(member.name);

                        membersList += `
                                    <li class="list-group-item">
                                        <div class="member-row" style="animation-delay: ${index * 60}ms;">
                                            <div class="avatar-initials" aria-hidden="true">${initials}</div>
                                            <div class="flex-grow-1 min-w-0">
                                                <div class="d-flex justify-content-between align-items-start gap-2">
                                                    <div class="min-w-0">
                                                        <span class="member-name d-block text-truncate">${name}</span>
                                                        <span class="member-meta">${plan} Plan • ${joinDate}</span>
                                                    </div>
                                                    <span class="member-status flex-shrink-0">New</span>
                                                </div>
                                            </div>
                                        </div>
                                    </li>`;
                    });
                }
                $('#recentMembersList').html(membersList);

                // --- Revenue Chart ---
                $('#chartLoading').addClass('d-none');

                if (!data.revenueChart || data.revenueChart.length === 0) {
                    $('#chartEmpty').removeClass('d-none');
                    $('.chart-wrapper').addClass('d-none');
                } else {
                    $('#chartEmpty').addClass('d-none');
                    $('.chart-wrapper').removeClass('d-none');
                    createRevenueChart(data.revenueChart);

                    // Optional summary badge (last month amount if available)
                    const last = data.revenueChart[data.revenueChart.length - 1];
                    if (last && typeof last.amount === 'number') {
                        $('#revenueSummaryBadge')
                            .text('Latest: $' + last.amount.toLocaleString())
                            .removeClass('d-none');
                    }
                }
            });
        }

        function createRevenueChart(data) {
            const ctx = document.getElementById('revenueChart').getContext('2d');
            if (revenueChart) revenueChart.destroy();

            // Gradient fill
            const gradient = ctx.createLinearGradient(0, 0, 0, 320);
            gradient.addColorStop(0, 'rgba(212, 175, 55, 0.28)');
            gradient.addColorStop(1, 'rgba(212, 175, 55, 0.02)');

            revenueChart = new Chart(ctx, {
                type: 'line',
                data: {
                    labels: data.map(d => d.month),
                    datasets: [{
                        label: 'Revenue',
                        data: data.map(d => d.amount),
                        borderColor: '#d4af37',
                        backgroundColor: gradient,
                        borderWidth: 2.5,
                        tension: 0.4,
                        pointBackgroundColor: '#d4af37',
                        pointBorderColor: '#0b0b0f',
                        pointBorderWidth: 2,
                        pointRadius: 4,
                        pointHoverRadius: 7,
                        pointHoverBackgroundColor: '#d4af37',
                        pointHoverBorderColor: '#fff',
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    interaction: {
                        mode: 'index',
                        intersect: false
                    },
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            backgroundColor: 'rgba(17, 17, 22, 0.95)',
                            titleColor: '#fff',
                            bodyColor: '#d4af37',
                            borderColor: 'rgba(212, 175, 55, 0.3)',
                            borderWidth: 1,
                            padding: 12,
                            cornerRadius: 8,
                            displayColors: false,
                            callbacks: {
                                label: function(context) {
                                    return 'Revenue: $' + context.parsed.y.toLocaleString();
                                }
                            }
                        }
                    },
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: {
                                color: 'rgba(255, 255, 255, 0.04)',
                                drawBorder: false
                            },
                            border: { display: false },
                            ticks: {
                                color: 'rgba(255, 255, 255, 0.45)',
                                font: { size: 11 },
                                padding: 8,
                                callback: value => '$' + value.toLocaleString()
                            }
                        },
                        x: {
                            grid: { display: false },
                            border: { display: false },
                            ticks: {
                                color: 'rgba(255, 255, 255, 0.45)',
                                font: { size: 11 },
                                maxRotation: 0,
                                autoSkip: true,
                                maxTicksLimit: 8
                            }
                        }
                    }
                }
            });
        }
    </script>
}