@{
    ViewData["Title"] = "Attendance Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="py-5" style="background: linear-gradient(to bottom, #121212, #1a1a1a); min-height: 100vh;">
    <div class="container-fluid px-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="display-5 fw-bold text-white mb-2">
                    Attendance <span class="text-gold">Management</span>
                </h1>
                <p class="text-white-60 fs-5 mb-0">Real-time tracking of today's elite check-ins</p>
            </div>
            <button type="button" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold" data-bs-toggle="modal" data-bs-target="#checkInModal">
                <i class="fas fa-sign-in-alt me-2"></i> Check-In Member
            </button>
        </div>

        <!-- Today's Attendance Card -->
        <div class="card premium-shadow rounded-4 overflow-hidden" style="background: #1a1a1a; border: 1px solid #333;">
            <div class="card-header py-4 px-5 d-flex justify-content-between align-items-center" style="background: #121212; border-bottom: 1px solid #333;">
                <div>
                    <h3 class="h5 fw-bold text-white mb-0">
                        <i class="fas fa-calendar-check text-gold me-3"></i> Today's Attendance
                    </h3>
                    <small class="text-white-50">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</small>
                </div>
                <div class="text-gold fw-bold fs-4" id="liveCount">0</div>
            </div>

            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead style="background: rgba(212,175,55,0.08);">
                            <tr>
                                <th class="text-white fw-bold ps-5 py-4">Member</th>
                                <th class="text-white fw-bold">Check-In</th>
                                <th class="text-white fw-bold">Check-Out</th>
                                <th class="text-white fw-bold">Duration</th>
                                <th class="text-white fw-bold">Status</th>
                                <th class="text-white fw-bold text-center pe-5">Action</th>
                            </tr>
                        </thead>
                        <tbody id="attendanceTableBody">
                            <tr>
                                <td colspan="6" class="text-center py-5 text-white-60">
                                    <i class="fas fa-spinner fa-spin fa-2x mb-3"></i><br>Loading today's attendance...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Check-In Modal -->
<div class="modal fade" id="checkInModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-gold" style="border: 2px solid #d4af37; border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold fs-4">
                    <i class="fas fa-crown text-gold me-3"></i> Elite Check-In
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <form id="checkInForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label text-white-70 fw-medium">Select Elite Member</label>
                        <select class="form-select form-select-lg rounded-pill" style="background: #1a1a1a; border: 1px solid #444; color: #fff; padding: 0.85rem 1.5rem;" 
                                name="memberId" id="memberSelect" required>
                            <option value="">Search or select member...</option>
                        </select>
                    </div>
                    <div class="modal-footer border-0 pt-0 justify-content-center">
                        <button type="button" class="btn btn-outline-light px-5 me-3" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold">
                            <i class="fas fa-sign-in-alt me-2"></i> Check-In Now
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold { color: #d4af37 !important; }
    .text-white-70 { color: rgba(255,255,255,0.7); }
    .text-white-60 { color: rgba(255,255,255,0.6); }
    .text-white-50 { color: rgba(255,255,255,0.5); }
    .btn-gold {
        background-color: #d4af37;
        color: #121212;
        border: none;
        font-weight: 700;
        transition: all 0.4s ease;
    }
    .btn-gold:hover {
        background-color: #c19a2b;
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(212,175,55,0.4);
    }
    .border-gold { border-color: #d4af37 !important; }
    .premium-shadow { box-shadow: 0 15px 50px rgba(0,0,0,0.7); }
    .shadow-gold { box-shadow: 0 10px 30px rgba(212,175,55,0.4); }
    .table tbody tr:hover {
        background: rgba(212,175,55,0.08) !important;
    }
    .form-select:focus {
        border-color: #d4af37;
        box-shadow: 0 0 0 0.2rem rgba(212,175,55,0.25);
    }
    .avatar-circle {
        width: 50px;
        height: 50px;
        background: rgba(212,175,55,0.15);
        border: 2px solid #d4af37;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadAttendance();
            loadMembers();
            // Auto-refresh every 30 seconds
            setInterval(loadAttendance, 30000);
        });

        function loadAttendance() {
            ajaxHelper.get('/Attendance/GetToday', function (data) {
                let html = '';
                let activeCount = 0;

                if (data.length === 0) {
                    html = `<tr><td colspan="6" class="text-center py-5 text-white-60">
                                <i class="fas fa-calendar-day fa-3x mb-3"></i><br>No check-ins yet today
                            </td></tr>`;
                } else {
                    data.forEach(function (att) {
                        if (att.status === 'Active') activeCount++;
                        html += `
                            <tr class="align-middle">
                                <td class="ps-5 py-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3">
                                            <i class="fas fa-user text-gold"></i>
                                        </div>
                                        <strong class="text-white">${escapeHtml(att.memberName)}</strong>
                                    </div>
                                </td>
                                <td class="text-white py-4">${att.checkInTime}</td>
                                <td class="text-white-60 py-4">${att.checkOutTime || '—'}</td>
                                <td class="text-white py-4">${att.duration || '—'}</td>
                                <td class="py-4">
                                    <span class="badge px-4 py-2 ${att.status === 'Active' ? 'bg-success' : 'bg-secondary'}">
                                        ${escapeHtml(att.status)}
                                    </span>
                                </td>
                                <td class="text-center pe-5 py-4">
                                    ${att.status === 'Active' ? 
                                        `<button class="btn btn-warning btn-sm rounded-pill px-4" onclick="checkOut(${att.id})">
                                            <i class="fas fa-sign-out-alt me-1"></i> Check-Out
                                         </button>` 
                                        : '<span class="text-white-50">Completed</span>'
                                    }
                                </td>
                            </tr>`;
                    });
                }

                $('#attendanceTableBody').html(html);
                $('#liveCount').text(activeCount + ' Active Now');
            });
        }

        function loadMembers() {
            ajaxHelper.get('/Attendance/GetMembers', function (data) {
                let options = '<option value="">Search or select member...</option>';
                data.forEach(function (member) {
                    options += `<option value="${member.id}">${escapeHtml(member.name)}</option>`;
                });
                $('#memberSelect').html(options);
            });
        }

        $('#checkInForm').on('submit', function (e) {
            e.preventDefault();
            const btn = $(this).find('button[type="submit"]');
            const original = btn.html();
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Processing...');

            $.ajax({
                url: '/Attendance/CheckIn',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        showToast('success', response.message || 'Member checked in successfully!');
                        $('#checkInModal').modal('hide');
                        $('#checkInForm')[0].reset();
                        loadAttendance();
                    } else {
                        showToast('error', response.message || 'Check-in failed');
                    }
                    btn.prop('disabled', false).html(original);
                },
                error: function () {
                    showToast('error', 'Network error. Please try again.');
                    btn.prop('disabled', false).html(original);
                }
            });
        });

        function checkOut(id) {
            if (!confirm('Confirm check-out for this member?')) return;

            $.ajax({
                url: '/Attendance/CheckOut',
                type: 'POST',
                data: {
                    attendanceId: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        showToast('success', response.message || 'Member checked out');
                        loadAttendance();
                    } else {
                        showToast('error', response.message);
                    }
                }
            });
        }
    </script>
}