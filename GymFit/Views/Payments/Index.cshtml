@{
    ViewData["Title"] = "Payments Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="py-5" style="background: linear-gradient(to bottom, #121212, #1a1a1a); min-height: 100vh;">
    <div class="container-fluid px-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="display-5 fw-bold text-white mb-2">
                    Payments <span class="text-gold">Management</span>
                </h1>
                <p class="text-white-60 fs-5 mb-0">Track and record revenue from your elite membership</p>
            </div>
            <button type="button" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold" data-bs-toggle="modal" data-bs-target="#recordPaymentModal">
                <i class="fas fa-credit-card me-2"></i> Record Payment
            </button>
        </div>

        <!-- Summary Stats -->
        <div class="row g-5 mb-5">
            <div class="col-xl-3 col-md-6">
                <div class="stat-card premium-shadow rounded-4 p-5 h-100 position-relative overflow-hidden" style="background: linear-gradient(135deg, #166534, #22c55e);">
                    <div class="stat-icon-large opacity-10">
                        <i class="fas fa-dollar-sign fa-5x"></i>
                    </div>
                    <div class="position-relative">
                        <p class="text-white-70 mb-2 fs-5">Monthly Revenue</p>
                        <h2 class="display-4 fw-bold text-white mb-0" id="monthlyRevenue">$0</h2>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card premium-shadow rounded-4 p-5 h-100 position-relative overflow-hidden" style="background: linear-gradient(135deg, #1e3a8a, #3b82f6);">
                    <div class="stat-icon-large opacity-10">
                        <i class="fas fa-calendar-day fa-5x"></i>
                    </div>
                    <div class="position-relative">
                        <p class="text-white-70 mb-2 fs-5">Today's Revenue</p>
                        <h2 class="display-4 fw-bold text-white mb-0" id="todayRevenue">$0</h2>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card premium-shadow rounded-4 p-5 h-100 position-relative overflow-hidden" style="background: linear-gradient(135deg, #0891b2, #06b6d4);">
                    <div class="stat-icon-large opacity-10">
                        <i class="fas fa-check-circle fa-5x"></i>
                    </div>
                    <div class="position-relative">
                        <p class="text-white-70 mb-2 fs-5">Today's Payments</p>
                        <h2 class="display-4 fw-bold text-white mb-0" id="todayPayments">0</h2>
                    </div>
                </div>
            </div>
            <div class="col-xl-3 col-md-6">
                <div class="stat-card premium-shadow rounded-4 p-5 h-100 position-relative overflow-hidden" style="background: linear-gradient(135deg, #d97706, #f59e0b);">
                    <div class="stat-icon-large opacity-10">
                        <i class="fas fa-clock fa-5x"></i>
                    </div>
                    <div class="position-relative">
                        <p class="text-white-70 mb-2 fs-5">Pending Payments</p>
                        <h2 class="display-4 fw-bold text-white mb-0" id="pendingPayments">0</h2>
                    </div>
                </div>
            </div>
        </div>

        <!-- Payments Table -->
        <div class="card premium-shadow rounded-4 overflow-hidden" style="background: #1a1a1a; border: 1px solid #333;">
            <div class="card-header py-4 px-5 d-flex justify-content-between align-items-center" style="background: #121212; border-bottom: 1px solid #333;">
                <h3 class="h5 fw-bold text-white mb-0">
                    <i class="fas fa-receipt text-gold me-3"></i> Transaction History
                </h3>
                <small class="text-white-50">All recorded payments</small>
            </div>
            <div class="card-body p-0">
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead style="background: rgba(212,175,55,0.08);">
                            <tr>
                                <th class="text-white fw-bold ps-5 py-4">Transaction ID</th>
                                <th class="text-white fw-bold">Member</th>
                                <th class="text-white fw-bold">Amount</th>
                                <th class="text-white fw-bold">Date</th>
                                <th class="text-white fw-bold">Method</th>
                                <th class="text-white fw-bold">Plan</th>
                                <th class="text-white fw-bold text-center pe-5">Status</th>
                            </tr>
                        </thead>
                        <tbody id="paymentsTableBody">
                            <tr>
                                <td colspan="7" class="text-center py-5 text-white-60">
                                    <i class="fas fa-spinner fa-spin fa-2x mb-3"></i><br>Loading transactions...
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- Record Payment Modal -->
<div class="modal fade" id="recordPaymentModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bg-dark border-gold" style="border: 2px solid #d4af37; border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold fs-4">
                    <i class="fas fa-credit-card text-gold me-3"></i> Record New Payment
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <form id="recordPaymentForm" method="post">
                    @Html.AntiForgeryToken()
                    <div class="mb-4">
                        <label class="form-label text-white-70 fw-medium">Elite Member</label>
                        <select class="form-select form-select-lg rounded-pill" style="background: #1a1a1a; border: 1px solid #444; color: #fff;" 
                                name="memberId" id="paymentMemberSelect" required>
                            <option value="">Search or select member...</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-white-70 fw-medium">Amount ($)</label>
                        <input type="number" class="form-control form-control-lg rounded-pill" name="amount" step="0.01" placeholder="0.00" required>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-white-70 fw-medium">Payment Method</label>
                        <select class="form-select form-select-lg rounded-pill" style="background: #1a1a1a; border: 1px solid #444; color: #fff;" name="paymentMethod" required>
                            <option value="">Choose method</option>
                            <option value="Cash">Cash</option>
                            <option value="Credit Card">Credit Card</option>
                            <option value="Debit Card">Debit Card</option>
                            <option value="UPI">UPI</option>
                            <option value="Bank Transfer">Bank Transfer</option>
                        </select>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-white-70 fw-medium">Notes (optional)</label>
                        <textarea class="form-control rounded-3" style="background: #1a1a1a; border: 1px solid #444; color: #fff;" name="notes" rows="3" placeholder="Additional details..."></textarea>
                    </div>
                </form>
            </div>
                <div class="modal-footer border-0 pt-0 justify-content-center">
                    <button type="button" class="btn btn-outline-light px-5 me-3" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold">
                        <i class="fas fa-save me-2"></i> Record Payment
                    </button>
                </div>
           
        </div>
    </div>
</div>

<style>
    .text-gold { color: #d4af37 !important; }
    .text-white-70 { color: rgba(255,255,255,0.7); }
    .text-white-60 { color: rgba(255,255,255,0.6); }
    .text-white-50 { color: rgba(255,255,255,0.5); }
    .btn-gold {
        background-color: #d4af37;
        color: #121212;
        border: none;
        font-weight: 700;
        transition: all 0.4s ease;
    }
    .btn-gold:hover {
        background-color: #c19a2b;
        transform: translateY(-4px);
        box-shadow: 0 20px 40px rgba(212,175,55,0.4);
    }
    .border-gold { border-color: #d4af37 !important; }
    .premium-shadow { box-shadow: 0 15px 50px rgba(0,0,0,0.7); }
    .shadow-gold { box-shadow: 0 10px 30px rgba(212,175,55,0.4); }
    .stat-card {
        transition: all 0.4s ease;
    }
    .stat-card:hover {
        transform: translateY(-12px);
    }
    .stat-icon-large {
        position: absolute;
        right: -10px;
        bottom: -20px;
        font-size: 8rem;
        pointer-events: none;
    }
    .table tbody tr:hover {
        background: rgba(212,175,55,0.08) !important;
    }
    .form-control:focus, .form-select:focus {
        border-color: #d4af37;
        box-shadow: 0 0 0 0.2rem rgba(212,175,55,0.25);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadPayments();
            loadStats();
            loadMembersForPayment();
        });

        function loadPayments() {
            ajaxHelper.get('/Payments/GetAll', function (data) {
                let html = '';
                if (data.length === 0) {
                    html = `<tr><td colspan="7" class="text-center py-5 text-white-60">
                                <i class="fas fa-receipt fa-3x mb-3"></i><br>No payments recorded yet
                            </td></tr>`;
                } else {
                    data.forEach(function (payment) {
                        const statusClass = payment.status === 'Completed' ? 'bg-success' : 'bg-warning';
                        html += `
                            <tr class="align-middle">
                                <td class="ps-5 py-4"><strong class="text-gold">#${payment.transactionId}</strong></td>
                                <td class="py-4">
                                    <div class="d-flex align-items-center">
                                        <div class="avatar-circle me-3">
                                            <i class="fas fa-user text-gold"></i>
                                        </div>
                                        <strong class="text-white">${payment.memberName}</strong>
                                    </div>
                                </td>
                                <td class="text-success fw-bold fs-4 py-4">$${payment.amount}</td>
                                <td class="text-white py-4">${payment.paymentDate}</td>
                                <td class="py-4"><span class="badge bg-info px-3 py-2">${payment.paymentMethod}</span></td>
                                <td class="text-white py-4">${payment.plan}</td>
                                <td class="text-center pe-5 py-4">
                                    <span class="badge px-4 py-2 ${statusClass}">${payment.status}</span>
                                </td>
                            </tr>`;
                    });
                }
                $('#paymentsTableBody').html(html);
            });
        }

        function loadStats() {
            ajaxHelper.get('/Payments/GetStats', function (data) {
                $('#monthlyRevenue').text('$' + data.monthlyRevenue.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}));
                $('#todayRevenue').text('$' + data.todayRevenue.toLocaleString(undefined, {minimumFractionDigits: 2, maximumFractionDigits: 2}));
                $('#todayPayments').text(data.todayPayments);
                $('#pendingPayments').text(data.pendingPayments);
            });
        }

        function loadMembersForPayment() {
            ajaxHelper.get('/Payments/GetMembers', function (data) {
                let options = '<option value="">Search or select member...</option>';
                data.forEach(function (member) {
                    options += `<option value="${member.id}">${member.name}</option>`;
                });
                $('#paymentMemberSelect').html(options);
            });
        }

        $('#recordPaymentForm').on('submit', function (e) {
            e.preventDefault();
            const btn = $(this).find('button[type="submit"]');
            const original = btn.html();
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Recording...');

            $.ajax({
                url: '/Payments/Record',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        showToast('success', response.message || 'Payment recorded successfully!');
                        $('#recordPaymentModal').modal('hide');
                        $('#recordPaymentForm')[0].reset();
                        loadPayments();
                        loadStats();
                    } else {
                        showToast('error', response.message || 'Failed to record payment');
                    }
                    btn.prop('disabled', false).html(original);
                },
                error: function () {
                    showToast('error', 'Network error. Please try again.');
                    btn.prop('disabled', false).html(original);
                }
            });
        });
    </script>
    <style>
        .avatar-circle {
            width: 50px;
            height: 50px;
            background: rgba(212,175,55,0.15);
            border: 2px solid #d4af37;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1.3rem;
        }
    </style>
}