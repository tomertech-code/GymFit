@model GymFit.Web.Controllers.ReportViewModel
@{ViewData["Title"]="Reports";}
<div class="container py-4"><div class="d-flex justify-content-between align-items-end mb-4"><div><h1 class="h2">Reports</h1><p class="text-muted">Management summary for the selected period.</p></div><form class="row g-2" method="get"><div class="col-auto"><input class="form-control" type="date" name="from" value="@Model.From.ToString("yyyy-MM-dd")"/></div><div class="col-auto"><input class="form-control" type="date" name="to" value="@Model.To.ToString("yyyy-MM-dd")"/></div><div class="col-auto"><button class="btn btn-dark">Apply</button></div></form></div><div class="row g-3 mb-4">@foreach(var x in new[]{("Revenue",Model.Revenue.ToString("C")),("Payments",Model.Payments.ToString()),("Attendance",Model.Attendance.ToString()),("New Members",Model.NewMembers.ToString()),("Active Members",Model.ActiveMembers.ToString()),("Active Subscriptions",Model.ActiveSubscriptions.ToString())}){<div class="col-md-4 col-xl-2"><div class="card shadow-sm h-100"><div class="card-body"><div class="small text-muted">@x.Item1</div><div class="h4 mb-0">@x.Item2</div></div></div></div>}</div><div class="row g-4"><div class="col-lg-6"><div class="card"><div class="card-header">Membership Plans</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Plan</th><th>Active subscriptions</th></tr></thead><tbody>@foreach(var x in Model.PlanBreakdown){<tr><td>@x.Name</td><td>@x.Subscriptions</td></tr>}</tbody></table></div></div></div><div class="col-lg-6"><div class="card"><div class="card-header">Branch Performance</div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Branch</th><th>Members</th><th>Revenue</th></tr></thead><tbody>@foreach(var x in Model.BranchBreakdown){<tr><td>@x.Name</td><td>@x.Members</td><td>@x.Revenue.ToString("C")</td></tr>}</tbody></table></div></div></div></div></div>
