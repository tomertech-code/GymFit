@{
    ViewData["Title"] = "Membership Plans";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="py-5" style="background: linear-gradient(to bottom, #121212, #1a1a1a); min-height: 100vh;">
    <div class="container-fluid px-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="display-5 fw-bold text-white mb-2">
                    Membership <span class="text-gold">Plans</span>
                </h1>
                <p class="text-white-60 fs-5 mb-0">Manage your exclusive tiered offerings</p>
            </div>
            <button type="button" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold" data-bs-toggle="modal" data-bs-target="#addPlanModal">
                <i class="fas fa-plus me-2"></i> Add New Plan
            </button>
        </div>

        <!-- Plans Grid -->
        <div class="row g-5" id="plansGrid">
            <div class="col-12 text-center py-5">
                <i class="fas fa-spinner fa-spin fa-3x text-gold mb-3"></i>
                <p class="text-white-60 fs-4">Loading elite plans...</p>
            </div>
        </div>
    </div>
</section>

<!-- Add Plan Modal -->
<div class="modal fade" id="addPlanModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-gold" style="border: 2px solid #d4af37; border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold fs-4">
                    <i class="fas fa-crown text-gold me-3"></i> Create New Elite Plan
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <form id="addPlanForm">
                    @Html.AntiForgeryToken()
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-white-70 fw-medium">Plan Name *</label>
                            <input type="text" class="form-control form-control-lg rounded-pill" name="name" placeholder="e.g. Premium Elite" required>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-white-70 fw-medium">Price ($ per month) *</label>
                            <input type="number" class="form-control form-control-lg rounded-pill" name="price" step="0.01" placeholder="299.00" required>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-white-70 fw-medium">Description *</label>
                        <textarea class="form-control rounded-3" style="background: #1a1a1a; border: 1px solid #444; color: #fff;" name="description" rows="3" placeholder="Exclusive benefits and luxury access..." required></textarea>
                    </div>
                    <div class="row">
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-white-70 fw-medium">Duration (Days) *</label>
                            <input type="number" class="form-control form-control-lg rounded-pill" name="durationDays" placeholder="30" required>
                        </div>
                        <div class="col-md-6 mb-4">
                            <label class="form-label text-white-70 fw-medium">Plan Type *</label>
                            <select class="form-select form-select-lg rounded-pill" style="background: #1a1a1a; border: 1px solid #444; color: #fff;" name="type" required>
                                <option value="">Select tier</option>
                                <option value="1">Basic</option>
                                <option value="2">Standard</option>
                                <option value="3">Premium</option>
                                <option value="4">VIP</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-4">
                        <label class="form-label text-white-70 fw-medium">Features (comma-separated) *</label>
                        <textarea class="form-control rounded-3" style="background: #1a1a1a; border: 1px solid #444; color: #fff;" name="features" rows="4" placeholder="24/7 access, Personal trainer, Spa access, VIP lounge..." required></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-0 justify-content-center">
                <button type="button" class="btn btn-outline-light px-5 me-3" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="addPlanForm" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold">
                    <i class="fas fa-save me-2"></i> Create Plan
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #d4af37 !important;
    }

    .text-white-70 {
        color: rgba(255,255,255,0.7);
    }

    .text-white-60 {
        color: rgba(255,255,255,0.6);
    }

    .btn-gold {
        background-color: #d4af37;
        color: #121212;
        border: none;
        font-weight: 700;
        transition: all 0.4s ease;
    }

        .btn-gold:hover {
            background-color: #c19a2b;
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(212,175,55,0.4);
        }

    .border-gold {
        border-color: #d4af37 !important;
    }

    .premium-shadow {
        box-shadow: 0 15px 50px rgba(0,0,0,0.7);
    }

    .shadow-gold {
        box-shadow: 0 10px 30px rgba(212,175,55,0.4);
    }

    .pricing-card {
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 24px;
        padding: 2.5rem;
        height: 100%;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }

        .pricing-card:hover {
            transform: translateY(-15px);
            box-shadow: 0 25px 60px rgba(212,175,55,0.15);
            border-color: #d4af37;
        }

        .pricing-card.featured {
            border: 2px solid #d4af37;
            box-shadow: 0 0 50px rgba(212,175,55,0.3);
            transform: scale(1.05);
        }

            .pricing-card.featured::before {
                content: 'MOST POPULAR';
                position: absolute;
                top: 20px;
                right: -40px;
                background: #d4af37;
                color: #121212;
                padding: 8px 50px;
                font-size: 0.8rem;
                font-weight: bold;
                transform: rotate(45deg);
                box-shadow: 0 5px 15px rgba(0,0,0,0.3);
            }

    .price-tag {
        font-size: 4rem;
        font-weight: bold;
        color: #d4af37;
    }

        .price-tag sup {
            font-size: 2rem;
            top: -1.5rem;
        }

        .price-tag sub {
            font-size: 1.5rem;
        }

    .features-list {
        list-style: none;
        padding: 0;
        margin: 0;
    }

        .features-list li {
            padding: 1rem 0;
            border-bottom: 1px solid #333;
            color: #f8f9fa;
            display: flex;
            align-items: center;
        }

            .features-list li i {
                color: #d4af37;
                margin-right: 1rem;
                font-size: 1.2rem;
            }

    .form-control:focus, .form-select:focus {
        border-color: #d4af37;
        box-shadow: 0 0 0 0.2rem rgba(212,175,55,0.25);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadPlans();
        });

        function loadPlans() {
            ajaxHelper.get('/MembershipPlans/GetAll', function (data) {
                let html = '';
                if (data.length === 0) {
                    html = `<div class="col-12 text-center py-5">
                                <i class="fas fa-layer-group fa-4x text-white-30 mb-4"></i>
                                <h4 class="text-white-60">No membership plans yet</h4>
                                <p class="text-white-50">Create your first elite tier to get started</p>
                            </div>`;
                } else {
                    data.forEach(function (plan) {
                        const features = plan.features.split(',');
                        let featuresHtml = '';
                        features.forEach(function (feature) {
                            featuresHtml += `<li><i class="fas fa-check-circle"></i> ${escapeHtml(feature.trim())}</li>`;
                        });
                        html += `
                            <div class="col-lg-4 col-md-6">
                                <div class="pricing-card ${plan.type === 3 ? 'featured' : ''} h-100 d-flex flex-column">
                                    <div class="text-center mb-4">
                                        <h3 class="h3 fw-bold text-white">${escapeHtml(plan.name)}</h3>
                                        <div class="price-tag">
                                            <sup>$</sup><span class="price">${plan.price.toFixed(0)}</span><sub>/mo</sub>
                                        </div>
                                        <p class="text-white-60 mt-3 px-3">${escapeHtml(plan.description)}</p>
                                    </div>
                                    <ul class="features-list flex-grow-1">${featuresHtml}</ul>
                                    <div class="text-center mt-4 mb-3">
                                        <span class="badge bg-gold text-dark px-4 py-2 fs-6">
                                            ${plan.subscriberCount} Active Subscribers
                                        </span>
                                    </div>
                                    <button class="btn btn-outline-danger w-100 mt-auto rounded-pill py-3" onclick="deletePlan(${plan.id})">
                                        <i class="fas fa-trash me-2"></i> Delete Plan
                                    </button>
                                </div>
                            </div>`;
                    });
                }
                $('#plansGrid').html(html);
            });
        }

        $('#addPlanForm').on('submit', function (e) {
            e.preventDefault();
            const btn = $(this).closest('.modal').find('button[type="submit"]');
            const original = btn.html();
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Creating...');

            $.ajax({
                url: '/MembershipPlans/Create',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        showToast('success', response.message || 'New elite plan created!');
                        $('#addPlanModal').modal('hide');
                        $('#addPlanForm')[0].reset();
                        loadPlans();
                    } else {
                        showToast('error', response.message || 'Failed to create plan');
                    }
                    btn.prop('disabled', false).html(original);
                },
                error: function () {
                    showToast('error', 'Network error. Please try again.');
                    btn.prop('disabled', false).html(original);
                }
            });
        });

        function deletePlan(id) {
            if (!confirm('Permanently delete this membership plan? This cannot be undone.')) return;

            $.ajax({
                url: '/MembershipPlans/Delete',
                type: 'POST',
                data: {
                    id: id,
                    __RequestVerificationToken: $('input[name="__RequestVerificationToken"]').val()
                },
                success: function (response) {
                    if (response.success) {
                        showToast('success', response.message || 'Plan deleted');
                        loadPlans();
                    } else {
                        showToast('error', response.message);
                    }
                }
            });
        }
    </script>
}