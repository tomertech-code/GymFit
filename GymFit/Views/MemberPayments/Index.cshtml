@model IReadOnlyList<GymFit.Domain.Entities.Payment>
@{ ViewData["Title"] = "My Payments"; }
<div class="container py-5"><h1 class="display-6 fw-bold mb-4">My payment history</h1><div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Date</th><th>Amount</th><th>Method</th><th>Plan</th><th>Status</th></tr></thead><tbody>@if (Model.Count == 0){<tr><td colspan="5" class="text-center py-4">No payment history is available.</td></tr>}@foreach (var payment in Model){<tr><td>@payment.PaymentDate.ToLocalTime().ToString("dd MMM yyyy")</td><td>@payment.Amount.ToString("C")</td><td>@payment.PaymentMethod</td><td>@(payment.Subscription?.MembershipPlan.Name ?? "N/A")</td><td>@payment.Status</td></tr>}</tbody></table></div></div></div>
