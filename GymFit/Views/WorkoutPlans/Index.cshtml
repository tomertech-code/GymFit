@model IReadOnlyList<GymFit.Domain.Entities.WorkoutPlan>
@{ ViewData["Title"] = "Workout Plans"; }
@using GymFit.Domain.Entities
@{ var assignedMembers = ViewBag.AssignedMembers as IReadOnlyList<Member> ?? Array.Empty<Member>(); }
<div class="container py-5"><div class="d-flex justify-content-between align-items-center mb-4"><h1 class="display-6 fw-bold">@(User.IsInRole("Member") ? "My workout plans" : "Workout plans")</h1>@if(User.IsInRole("Trainer")){<button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#createPlan">Create plan</button>}</div><div class="row g-4">@if (Model.Count == 0){<div class="col-12"><div class="alert alert-secondary">No workout plans are available.</div></div>}@foreach (var plan in Model){<div class="col-lg-6"><div class="card shadow-sm h-100"><div class="card-body"><h2 class="h5">@plan.Name</h2><p class="text-muted">Member: @plan.Member.User.FirstName @plan.Member.User.LastName · Trainer: @plan.Trainer.User.FirstName @plan.Trainer.User.LastName</p><p>@plan.Description</p><h3 class="h6">Exercises</h3>@if(plan.Exercises.Count == 0){<p class="text-muted">No exercises assigned.</p>}else{<ul>@foreach(var exercise in plan.Exercises){<li>@exercise.Name — @exercise.Sets sets × @exercise.Reps reps</li>}</ul>}</div></div></div>}</div></div>
@if(User.IsInRole("Trainer")){<div class="modal fade" id="createPlan" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5 modal-title">Create workout plan</h2></div><div class="modal-body"><label class="form-label">Member</label><select class="form-select mb-3" name="MemberId" required><option value="">Select member</option>@foreach(var member in assignedMembers){<option value="@member.Id">@member.User.FirstName @member.User.LastName</option>}</select><label class="form-label">Name</label><input class="form-control mb-3" name="Name" required maxlength="150" /><label class="form-label">Description</label><textarea class="form-control mb-3" name="Description" maxlength="1000"></textarea><label class="form-label">Start date</label><input class="form-control" type="date" name="StartDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required /></div><div class="modal-footer"><button class="btn btn-danger">Create</button></div></form></div></div></div>}
