@{
    ViewData["Title"] = "Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}
@model IReadOnlyList<GymFit.Domain.Entities.DietPlan>
@using GymFit.Domain.Entities
@{ ViewData["Title"]="Diet Plans"; var members=ViewBag.Members as IEnumerable<Member> ?? Array.Empty<Member>(); }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Diet Plans</h1><p class="text-muted mb-0">Nutrition plans, macros and meals.</p></div>@if(User.IsInRole("Admin")||User.IsInRole("Trainer")){<button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#newDiet">Create Diet Plan</button>}</div>
<div class="row g-4">@foreach(var p in Model){<div class="col-lg-6"><div class="card h-100 shadow-sm"><div class="card-body"><div class="d-flex justify-content-between"><h2 class="h5">@p.Name</h2><span class="badge text-bg-danger">@p.Goal</span></div><div class="small text-muted mb-3">@p.Member.User.FirstName @p.Member.User.LastName · @p.StartDate.ToString("dd MMM yyyy")</div><div class="row text-center g-2 mb-3"><div class="col"><div class="border rounded p-2"><strong>@p.DailyCalories</strong><small class="d-block text-muted">kcal</small></div></div><div class="col"><div class="border rounded p-2"><strong>@p.ProteinGrams g</strong><small class="d-block text-muted">Protein</small></div></div><div class="col"><div class="border rounded p-2"><strong>@p.CarbsGrams g</strong><small class="d-block text-muted">Carbs</small></div></div><div class="col"><div class="border rounded p-2"><strong>@p.FatGrams g</strong><small class="d-block text-muted">Fat</small></div></div></div><h3 class="h6">Meals</h3>@if(!p.Meals.Any()){<p class="text-muted">No meals added yet.</p>}else{<div class="list-group mb-3">@foreach(var m in p.Meals.OrderBy(x=>x.MealOrder)){<div class="list-group-item"><strong>@m.MealType</strong> <span class="text-muted">— @m.FoodItems</span>@if(m.Calories.HasValue){<small class="d-block text-muted">@m.Calories kcal</small>}</div>}</div>}@if(User.IsInRole("Admin")||User.IsInRole("Trainer")){<button class="btn btn-sm btn-outline-danger" data-bs-toggle="modal" data-bs-target="#meal-@p.Id">Add Meal</button><form asp-action="Delete" method="post" class="d-inline ms-2">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@p.Id"/><button class="btn btn-sm btn-outline-secondary" onclick="return confirm('Deactivate this diet plan?')">Deactivate</button></form>}</div></div></div>}</div></div>
@if(User.IsInRole("Admin")||User.IsInRole("Trainer")){<div class="modal fade" id="newDiet"><div class="modal-dialog"><div class="modal-content"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5">Create Diet Plan</h2></div><div class="modal-body"><select class="form-select mb-2" name="MemberId" required><option value="">Select member</option>@foreach(var m in members){<option value="@m.Id">@m.User.FirstName @m.User.LastName</option>}</select><input class="form-control mb-2" name="Name" placeholder="Plan name" required maxlength="150"/><input class="form-control mb-2" name="Goal" placeholder="Goal e.g. Fat loss" required maxlength="100"/><div class="row g-2"><div class="col-6"><input class="form-control" name="DailyCalories" type="number" min="1" placeholder="Calories" required/></div><div class="col-6"><input class="form-control" name="ProteinGrams" type="number" min="0" placeholder="Protein g" required/></div><div class="col-6"><input class="form-control" name="CarbsGrams" type="number" min="0" placeholder="Carbs g" required/></div><div class="col-6"><input class="form-control" name="FatGrams" type="number" min="0" placeholder="Fat g" required/></div></div><div class="row g-2 mt-1"><div class="col"><input class="form-control" type="date" name="StartDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")"/></div><div class="col"><input class="form-control" type="date" name="EndDate"/></div></div></div><div class="modal-footer"><button class="btn btn-danger">Create</button></div></form></div></div></div>@foreach(var p in Model){<div class="modal fade" id="meal-@p.Id"><div class="modal-dialog"><div class="modal-content"><form asp-action="AddMeal" method="post">@Html.AntiForgeryToken()<input type="hidden" name="DietPlanId" value="@p.Id"/><div class="modal-header"><h2 class="h5">Add meal</h2></div><div class="modal-body"><input class="form-control mb-2" name="MealOrder" type="number" min="1" value="1" placeholder="Order"/><input class="form-control mb-2" name="MealType" placeholder="Breakfast / Lunch / Dinner" required/><textarea class="form-control mb-2" name="FoodItems" placeholder="Food items" required></textarea><input class="form-control mb-2" name="Calories" type="number" min="0" placeholder="Calories"/><input class="form-control" name="Notes" placeholder="Notes"/></div><div class="modal-footer"><button class="btn btn-danger">Add meal</button></div></form></div></div></div>}}</div>}
