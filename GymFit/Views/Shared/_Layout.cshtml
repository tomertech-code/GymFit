<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - GymFit</title>

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
    <link rel="stylesheet" href="~/css/site.css" />

    <!-- Optional Styles section for views -->
    @RenderSection("Styles", required: false)
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark sticky-top">
        <div class="container">
            <a class="navbar-brand fw-bold" href="/">
                <i class="fas fa-dumbbell text-danger"></i> GYM<span class="text-danger">FIT</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarNav">
                <ul class="navbar-nav ms-auto">
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Index">Home</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="About">About</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Plans">Plans</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Trainers">Trainers</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link" asp-controller="Home" asp-action="Contact">Contact</a>
                    </li>
                    @if (!string.IsNullOrWhiteSpace(Context.RequestServices.GetRequiredService<IConfiguration>()["WhatsApp:Number"]))
                    {
                        var whatsappNumber = Context.RequestServices.GetRequiredService<IConfiguration>()["WhatsApp:Number"]!.Replace("+", "").Replace(" ", "").Replace("-", "");
                        <li class="nav-item"><a class="nav-link text-success" href="https://wa.me/@whatsappNumber" target="_blank" rel="noopener"><i class="fab fa-whatsapp"></i> WhatsApp</a></li>
                    }
                    @if (User.Identity?.IsAuthenticated == true)
                    {
                        <li class="nav-item dropdown">
                            <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown">
                                <i class="fas fa-user"></i> @User.Identity.Name
                            </a>
                            <ul class="dropdown-menu dropdown-menu-end">
                                @if (User.IsInRole("Admin"))
                                {
                                    <li><a class="dropdown-item"  asp-controller="AdminDashboard" asp-action="Index">Dashboard</a></li>
                                }
                                else if (User.IsInRole("Reception"))
                                {
                                    <li><a class="dropdown-item" asp-controller="ReceptionDashboard" asp-action="Index">Dashboard</a></li>
                                }
                                else if (User.IsInRole("Trainer"))
                                {
                                    <li><a class="dropdown-item" asp-controller="Trainer" asp-action="Dashboard">Dashboard</a></li>
                                    <li><a class="dropdown-item" asp-controller="WorkoutPlans" asp-action="Index">Workout plans</a></li>
                                    <li><a class="dropdown-item" asp-controller="DietPlans" asp-action="Index">Diet plans</a></li>
                                    <li><a class="dropdown-item" asp-controller="Progress" asp-action="Index">Progress</a></li>
                                    <li><a class="dropdown-item" asp-controller="Measurements" asp-action="Index">Measurements</a></li>
                                    <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index">Notifications</a></li>
                                }
                                else if (User.IsInRole("Member"))
                                {
                                    <li><a class="dropdown-item" href="/Member/Dashboard">Dashboard</a></li>
                                    <li><a class="dropdown-item" href="/Member/Dashboard/Profile">My profile</a></li>
                                    <li><a class="dropdown-item" asp-controller="WorkoutPlans" asp-action="Index">My workouts</a></li>
                                    <li><a class="dropdown-item" asp-controller="MemberAttendance" asp-action="Index">My attendance</a></li>
                                    <li><a class="dropdown-item" asp-controller="MemberPayments" asp-action="Index">My payments</a></li>
                                    <li><a class="dropdown-item" asp-controller="DietPlans" asp-action="Index">My diet</a></li>
                                    <li><a class="dropdown-item" asp-controller="Progress" asp-action="Index">My progress</a></li>
                                    <li><a class="dropdown-item" asp-controller="Measurements" asp-action="Index">My measurements</a></li>
                                    <li><a class="dropdown-item" asp-controller="Notifications" asp-action="Index">Notifications</a></li>
                                }
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form method="post" asp-controller="Account" asp-action="Logout" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="dropdown-item">Logout</button>
                                    </form>
                                </li>
                            </ul>
                        </li>
                    }
                    else
                    {
                        <li class="nav-item">
                            <a class="nav-link" asp-controller="Account" asp-action="Login">Login</a>
                        </li>
                        <li class="nav-item">
                            <a class="btn btn-danger ms-2" asp-controller="Account" asp-action="Register">Join Now</a>
                        </li>
                    }
                </ul>
            </div>
        </div>
    </nav>

    <main>
        @RenderBody()
    </main>

    <footer class="bg-dark text-white py-4 mt-5">
        <div class="container text-center">
            <p>&copy; 2024 GymFit. All rights reserved. Built with ASP.NET Core</p>
        </div>
    </footer>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery/3.7.0/jquery.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/bootstrap/5.3.0/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ajaxHelper.js"></script>
    <script src="~/js/toast.js"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
