@model IReadOnlyList<GymFit.Domain.Entities.ProgressRecord>
@using GymFit.Domain.Entities
@{ViewData["Title"]="Progress Tracking";var members=ViewBag.Members as IEnumerable<Member> ?? Array.Empty<Member>();}
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Progress Tracking</h1><p class="text-muted">Track weight, body fat, muscle and strength over time.</p></div>@if(!User.IsInRole("Member")){<button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#progressAdd">Add Progress</button>}</div><div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Date</th><th>Member</th><th>Weight</th><th>Body Fat</th><th>Muscle</th><th>Strength</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.RecordDate.ToString("dd MMM yyyy")</td><td>@x.Member.User.FirstName @x.Member.User.LastName</td><td>@(x.WeightKg?.ToString("0.##") ?? "—") kg</td><td>@(x.BodyFatPercentage?.ToString("0.##") ?? "—")%</td><td>@(x.MuscleMassKg?.ToString("0.##") ?? "—") kg</td><td>@(x.StrengthScore?.ToString("0.##") ?? "—")</td><td>@if(!User.IsInRole("Member")){<form asp-action="Delete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form>}</td></tr>}@if(!Model.Any()){<tr><td colspan="7" class="text-center text-muted py-4">No progress records yet.</td></tr>}</tbody></table></div></div></div>
@if(!User.IsInRole("Member")){<div class="modal fade" id="progressAdd"><div class="modal-dialog"><div class="modal-content"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5">Add Progress</h2></div><div class="modal-body"><select class="form-select mb-2" name="MemberId" required><option value="">Select member</option>@foreach(var m in members){<option value="@m.Id">@m.User.FirstName @m.User.LastName</option>}</select><input class="form-control mb-2" name="RecordDate" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")"/><div class="row g-2"><div class="col-6"><input class="form-control" name="WeightKg" type="number" step="0.01" placeholder="Weight kg"/></div><div class="col-6"><input class="form-control" name="BodyFatPercentage" type="number" step="0.01" placeholder="Body fat %"/></div><div class="col-6"><input class="form-control" name="MuscleMassKg" type="number" step="0.01" placeholder="Muscle kg"/></div><div class="col-6"><input class="form-control" name="StrengthScore" type="number" step="0.01" placeholder="Strength score"/></div></div><textarea class="form-control mt-2" name="Notes" maxlength="1000" placeholder="Notes"></textarea></div><div class="modal-footer"><button class="btn btn-danger">Save</button></div></form></div></div></div>}
