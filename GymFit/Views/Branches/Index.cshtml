@{
    ViewData["Title"] = "Branch Management";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="py-5" style="background: linear-gradient(to bottom, #121212, #1a1a1a); min-height: 100vh;">
    <div class="container-fluid px-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="display-5 fw-bold text-white mb-2">
                    Branch <span class="text-gold">Management</span>
                </h1>
                <p class="text-white-60 fs-5 mb-0">Oversee your network of elite fitness locations</p>
            </div>
            <button type="button" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold" data-bs-toggle="modal" data-bs-target="#addBranchModal">
                <i class="fas fa-building me-2"></i> Add New Branch
            </button>
        </div>

        <!-- Branches Grid -->
        <div class="row g-5" id="branchesGrid">
            <div class="col-12 text-center py-5">
                <i class="fas fa-spinner fa-spin fa-3x text-gold mb-4"></i>
                <p class="text-white-60 fs-4">Loading branch network...</p>
            </div>
        </div>
    </div>
</section>

<!-- Add Branch Modal -->
<div class="modal fade" id="addBranchModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-gold" style="border: 2px solid #d4af37; border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold fs-4">
                    <i class="fas fa-building text-gold me-3"></i> Add New Elite Branch
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-2">
                <form id="branchForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label text-white-70 fw-medium">Branch Name *</label>
                            <input type="text" class="form-control form-control-lg rounded-pill" name="Name" placeholder="e.g. Downtown Elite" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-70 fw-medium">Branch Code *</label>
                            <input type="text" class="form-control form-control-lg rounded-pill" name="Code" placeholder="e.g. DT001" required>
                        </div>
                    </div>
                    <div class="mt-4">
                        <label class="form-label text-white-70 fw-medium">Full Address *</label>
                        <textarea class="form-control rounded-3" style="background: #1a1a1a; border: 1px solid #444; color: #fff;" name="Address" rows="3" placeholder="Street address..." required></textarea>
                    </div>
                    <div class="row g-4 mt-2">
                        <div class="col-md-4">
                            <label class="form-label text-white-70 fw-medium">City *</label>
                            <input type="text" class="form-control form-control-lg rounded-pill" name="City" placeholder="New York" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-white-70 fw-medium">State *</label>
                            <input type="text" class="form-control form-control-lg rounded-pill" name="State" placeholder="NY" required>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label text-white-70 fw-medium">Pin Code *</label>
                            <input type="text" class="form-control form-control-lg rounded-pill" name="PinCode" placeholder="10001" required>
                        </div>
                    </div>
                    <div class="row g-4 mt-4">
                        <div class="col-md-6">
                            <label class="form-label text-white-70 fw-medium">Phone Number *</label>
                            <input type="tel" class="form-control form-control-lg rounded-pill" name="PhoneNumber" placeholder="+1 (555) 123-4567" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-70 fw-medium">Email Address *</label>
                            <input type="email" class="form-control form-control-lg rounded-pill" name="Email" placeholder="downtown@gymfit.com" required>
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-4 justify-content-center">
                <button type="button" class="btn btn-outline-light px-5 me-3" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="branchForm" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold">
                    <i class="fas fa-save me-2"></i> Save Branch
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #d4af37 !important;
    }

    .text-white-70 {
        color: rgba(255,255,255,0.7);
    }

    .text-white-60 {
        color: rgba(255,255,255,0.6);
    }

    .btn-gold {
        background-color: #d4af37;
        color: #121212;
        border: none;
        font-weight: 700;
        transition: all 0.4s ease;
    }

        .btn-gold:hover {
            background-color: #c19a2b;
            transform: translateY(-4px);
            box-shadow: 0 20px 40px rgba(212,175,55,0.4);
        }

    .border-gold {
        border-color: #d4af37 !important;
    }

    .premium-shadow {
        box-shadow: 0 15px 50px rgba(0,0,0,0.7);
    }

    .shadow-gold {
        box-shadow: 0 10px 30px rgba(212,175,55,0.4);
    }

    .branch-card {
        background: #1a1a1a;
        border: 1px solid #333;
        border-radius: 24px;
        padding: 2.5rem;
        height: 100%;
        transition: all 0.4s ease;
        position: relative;
        overflow: hidden;
    }

        .branch-card:hover {
            transform: translateY(-15px);
            box-shadow: 0 25px 60px rgba(212,175,55,0.15);
            border-color: #d4af37;
        }

    .branch-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1.5rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid #444;
    }

    .branch-code {
        text-align: center;
        font-size: 1.8rem;
        font-weight: bold;
        color: #d4af37;
        background: rgba(212,175,55,0.1);
        padding: 1rem;
        border-radius: 16px;
        margin: 1.5rem 0;
    }

    .branch-info p {
        margin: 1rem 0;
        font-size: 1.1rem;
        display: flex;
        align-items: center;
    }

    .branch-info i {
        color: #d4af37;
        margin-right: 1rem;
        font-size: 1.3rem;
        width: 30px;
    }

    .member-count {
        font-size: 2rem;
        font-weight: bold;
        color: #d4af37;
        margin-top: 1rem;
    }

    .form-control:focus, .form-select:focus {
        border-color: #d4af37;
        box-shadow: 0 0 0 0.2rem rgba(212,175,55,0.25);
    }
</style>

@section Scripts {
    <script>
        $(document).ready(function () {
            loadBranches();
        });

        function loadBranches() {
            ajaxHelper.get('/Branches/GetAll', function (branches) {
                let html = '';
                if (branches.length === 0) {
                    html = `<div class="col-12 text-center py-5">
                                <i class="fas fa-building fa-4x text-white-30 mb-4"></i>
                                <h4 class="text-white-60">No branches added yet</h4>
                                <p class="text-white-50">Expand your elite network by adding your first location</p>
                            </div>`;
                } else {
                    branches.forEach(function (branch) {
                        html += `
                            <div class="col-lg-4 col-md-6">
                                <div class="branch-card h-100 d-flex flex-column">
                                    <div class="branch-header">
                                        <h4 class="text-white fw-bold">${branch.name}</h4>
                                        <span class="badge px-4 py-2 fs-6 ${branch.isActive ? 'bg-success' : 'bg-secondary'}">
                                            ${branch.isActive ? 'Active' : 'Inactive'}
                                        </span>
                                    </div>
                                    <div class="branch-code">${branch.code}</div>
                                    <div class="branch-info flex-grow-1">
                                        <p><i class="fas fa-map-marker-alt"></i> ${branch.address}<br>
                                           <span class="ms-4">${branch.city}, ${branch.state} ${branch.pinCode}</span></p>
                                        <p><i class="fas fa-phone"></i> ${branch.phoneNumber}</p>
                                        <p><i class="fas fa-envelope"></i> ${branch.email}</p>
                                    </div>
                                    <div class="text-center mt-4">
                                        <div class="member-count">${branch.memberCount}</div>
                                        <small class="text-white-60">Elite Members</small>
                                    </div>
                                </div>
                            </div>`;
                    });
                }
                $('#branchesGrid').html(html);
            });
        }

        $('#branchForm').on('submit', function (e) {
            e.preventDefault();
            const btn = $(this).closest('.modal').find('button[type="submit"]');
            const original = btn.html();
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Saving...');

            $.ajax({
                url: '/Branches/Create',
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        showToast('success', response.message || 'New branch added successfully!');
                        $('#addBranchModal').modal('hide');
                        $('#branchForm')[0].reset();
                        loadBranches();
                    } else {
                        showToast('error', response.message || 'Failed to add branch');
                    }
                    btn.prop('disabled', false).html(original);
                },
                error: function () {
                    showToast('error', 'Network error. Please try again.');
                    btn.prop('disabled', false).html(original);
                }
            });
        });
    </script>
}