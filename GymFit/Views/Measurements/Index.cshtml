@model IReadOnlyList<GymFit.Domain.Entities.BodyMeasurement>
@using GymFit.Domain.Entities
@{ViewData["Title"]="Body Measurements";var members=ViewBag.Members as IEnumerable<Member> ?? Array.Empty<Member>();}
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Body Measurements</h1><p class="text-muted">Track measurements in centimetres.</p></div>@if(!User.IsInRole("Member")){<button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#measureAdd">Add Measurement</button>}</div><div class="card shadow-sm"><div class="table-responsive"><table class="table table-sm table-hover mb-0"><thead><tr><th>Date</th><th>Member</th><th>Chest</th><th>Waist</th><th>Hips</th><th>L Arm</th><th>R Arm</th><th>L Thigh</th><th>R Thigh</th><th></th></tr></thead><tbody>@foreach(var x in Model){<tr><td>@x.MeasurementDate.ToString("dd MMM yyyy")</td><td>@x.Member.User.FirstName @x.Member.User.LastName</td><td>@(x.ChestCm?.ToString("0.##") ?? "—")</td><td>@(x.WaistCm?.ToString("0.##") ?? "—")</td><td>@(x.HipsCm?.ToString("0.##") ?? "—")</td><td>@(x.LeftArmCm?.ToString("0.##") ?? "—")</td><td>@(x.RightArmCm?.ToString("0.##") ?? "—")</td><td>@(x.LeftThighCm?.ToString("0.##") ?? "—")</td><td>@(x.RightThighCm?.ToString("0.##") ?? "—")</td><td>@if(!User.IsInRole("Member")){<form asp-action="Delete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@x.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form>}</td></tr>}@if(!Model.Any()){<tr><td colspan="10" class="text-center text-muted py-4">No measurements yet.</td></tr>}</tbody></table></div></div></div>
@if(!User.IsInRole("Member")){<div class="modal fade" id="measureAdd"><div class="modal-dialog modal-lg"><div class="modal-content"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5">Add Measurement</h2></div><div class="modal-body"><select class="form-select mb-2" name="MemberId" required><option value="">Select member</option>@foreach(var m in members){<option value="@m.Id">@m.User.FirstName @m.User.LastName</option>}</select><input class="form-control mb-3" name="MeasurementDate" type="date" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")"/><div class="row g-2">@foreach(var field in new[]{("ChestCm","Chest"),("WaistCm","Waist"),("HipsCm","Hips"),("LeftArmCm","Left Arm"),("RightArmCm","Right Arm"),("LeftThighCm","Left Thigh"),("RightThighCm","Right Thigh")}){<div class="col-md-3"><label class="form-label">@field.Item2</label><input class="form-control" name="@field.Item1" type="number" step="0.01" min="1"/></div>}</div><textarea class="form-control mt-3" name="Notes" maxlength="1000" placeholder="Notes"></textarea></div><div class="modal-footer"><button class="btn btn-danger">Save</button></div></form></div></div></div>}
