@model IReadOnlyList<GymFit.Domain.Entities.Subscription>
@using GymFit.Domain.Entities
@{ ViewData["Title"] = "Memberships"; var members = (IReadOnlyList<Member>)ViewBag.Members; var plans = (IReadOnlyList<MembershipPlan>)ViewBag.Plans; }
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><h1 class="h2">Memberships</h1><button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#assignModal">Assign / renew</button></div>@if (TempData["Success"] is string message){<div class="alert alert-success">@message</div>}<form method="get" class="row g-2 mb-3"><div class="col-md-6"><input class="form-control" name="search" value="@ViewBag.Search" placeholder="Search member or plan" /></div><div class="col-auto"><button class="btn btn-outline-secondary">Search</button></div><div class="col-auto"><a class="btn btn-outline-secondary" asp-action="Index" asp-route-includeExpired="true">Show expired</a></div></form><div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Member</th><th>Plan</th><th>Start</th><th>End</th><th>Status</th></tr></thead><tbody>@if(Model.Count == 0){<tr><td colspan="5" class="text-center py-4">No memberships found.</td></tr>}@foreach(var membership in Model){<tr><td>@membership.Member.User.FirstName @membership.Member.User.LastName</td><td>@membership.MembershipPlan.Name</td><td>@membership.StartDate.ToString("dd MMM yyyy")</td><td>@membership.EndDate.ToString("dd MMM yyyy")</td><td><span class="badge @(membership.EndDate < DateTime.UtcNow ? "bg-danger" : "bg-success")">@(membership.EndDate < DateTime.UtcNow ? "Expired" : membership.Status.ToString())</span></td></tr>}</tbody></table></div></div></div>
<div class="modal fade" id="assignModal" tabindex="-1"><div class="modal-dialog"><div class="modal-content"><form asp-action="Assign" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5 modal-title">Assign or renew membership</h2><button type="button" class="btn-close" data-bs-dismiss="modal"></button></div><div class="modal-body"><label class="form-label">Member</label><select class="form-select mb-3" name="MemberId" required><option value="">Select member</option>@foreach(var member in members){<option value="@member.Id">@member.User.FirstName @member.User.LastName</option>}</select><label class="form-label">Plan</label><select class="form-select mb-3" name="MembershipPlanId" required><option value="">Select plan</option>@foreach(var plan in plans){<option value="@plan.Id">@plan.Name (@plan.Price.ToString("C"))</option>}</select><label class="form-label">Start date</label><input class="form-control" type="date" name="StartDate" value="@DateTime.UtcNow.ToString("yyyy-MM-dd")" required /></div><div class="modal-footer"><button class="btn btn-danger">Save membership</button></div></form></div></div></div>
