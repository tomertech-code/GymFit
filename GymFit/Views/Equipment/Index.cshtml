@model IReadOnlyList<GymFit.Domain.Entities.Branch>
@using GymFit.Domain.Entities
@{ViewData["Title"]="Equipment";var branches=ViewBag.Branches as IEnumerable<Branch> ?? Array.Empty<Branch>();}
<div class="container py-4"><div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Equipment Management</h1><p class="text-muted">Track gym equipment and maintenance status by branch.</p></div><button class="btn btn-danger" data-bs-toggle="modal" data-bs-target="#equipmentAdd">Add Equipment</button></div>@foreach(var b in Model){<div class="card shadow-sm mb-4"><div class="card-header d-flex justify-content-between"><strong>@b.Name</strong><span>@b.Equipment.Count(x=>x.IsWorking) working / @b.Equipment.Count total</span></div><div class="table-responsive"><table class="table mb-0"><thead><tr><th>Equipment</th><th>Category</th><th>Qty</th><th>Brand</th><th>Maintenance</th><th>Status</th><th></th></tr></thead><tbody>@foreach(var e in b.Equipment.OrderBy(x=>x.EquipmentName)){<tr><td>@e.EquipmentName</td><td>@e.Category</td><td>@e.Quantity</td><td>@e.Brand</td><td>@e.MaintenanceSchedule</td><td><span class="badge @(e.IsWorking?"text-bg-success":"text-bg-warning")">@(e.IsWorking?"Working":"Maintenance")</span></td><td><form asp-action="Toggle" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"/><button class="btn btn-sm btn-outline-secondary">Toggle</button></form> <form asp-action="Delete" method="post" class="d-inline">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@e.Id"/><button class="btn btn-sm btn-outline-danger">Delete</button></form></td></tr>}</tbody></table></div></div>}</div>
<div class="modal fade" id="equipmentAdd"><div class="modal-dialog"><div class="modal-content"><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div class="modal-header"><h2 class="h5">Add Equipment</h2></div><div class="modal-body"><select class="form-select mb-2" name="BranchId" required><option value="">Select branch</option>@foreach(var b in branches){<option value="@b.Id">@b.Name</option>}</select><input class="form-control mb-2" name="EquipmentName" placeholder="Equipment name" required/><input class="form-control mb-2" name="Category" placeholder="Category" required/><input class="form-control mb-2" name="Quantity" type="number" min="1" value="1"/><input class="form-control mb-2" name="Brand" placeholder="Brand"/><input class="form-control mb-2" name="PurchaseDate" type="date"/><input class="form-control" name="MaintenanceSchedule" placeholder="Maintenance schedule"/></div><div class="modal-footer"><button class="btn btn-danger">Save</button></div></form></div></div></div>
