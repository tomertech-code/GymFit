@using GymFit.Domain.Entities
@model List<TrainerViewModel>
@{
    ViewData["Title"] = "Trainers";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="py-4" style="background: linear-gradient(to bottom, #121212, #1a1a1a); min-height: 100vh;">
    <div class="container-fluid px-4">
        <!-- Header -->
        <div class="d-flex justify-content-between align-items-center mb-5">
            <div>
                <h1 class="display-5 fw-bold text-white mb-2">
                    Elite <span class="text-gold">Trainers</span>
                </h1>
                <p class="text-white-60 mb-0">Manage your world-class coaching team</p>
            </div>
            <button type="button" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold" data-bs-toggle="modal" data-bs-target="#addTrainerModal">
                <i class="fas fa-plus me-2"></i> Add New Trainer
            </button>
        </div>

        <!-- Trainers Table Card -->
        <div class="card premium-shadow rounded-4 overflow-hidden" style="background: #1a1a1a; border: 1px solid #333;">
            <div class="card-header py-4 px-5" style="background: linear-gradient(to right, #1e1e1e, #121212); border-bottom: 1px solid #333;">
                <div class="row align-items-center">
                    <div class="col">
                        <h3 class="h4 fw-bold text-white mb-0">
                            <i class="fas fa-dumbbell text-gold me-3"></i>
                            Trainer Directory (@Model.Count Active)
                        </h3>
                    </div>
                    <div class="col-auto">
                        <span class="text-white-60 small">
                            Last updated: @DateTime.Now.ToString("MMM dd, yyyy 'at' HH:mm")
                        </span>
                    </div>
                </div>
            </div>

            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-user-tie fa-5x text-white-30 mb-4"></i>
                        <h5 class="text-white-60">No trainers added yet</h5>
                        <p class="text-white-50">Start building your elite coaching team</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover mb-0">
                            <thead style="background: rgba(212,175,55,0.08);">
                                <tr>
                                    <th class="text-white fw-bold ps-5 py-4">Trainer</th>
                                    <th class="text-white fw-bold">Contact</th>
                                    <th class="text-white fw-bold">Specialization</th>
                                    <th class="text-white fw-bold">Experience</th>
                                    <th class="text-white fw-bold">Members</th>
                                    <th class="text-white fw-bold">Branch</th>
                                    <th class="text-white fw-bold">Status</th>
                                    <th class="text-white fw-bold text-center pe-5">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var trainer in Model)
                                {
                                    <tr class="border-bottom border-dark align-middle" style="transition: all 0.3s ease;">
                                        <td class="ps-5 py-4">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle me-4">
                                                    <i class="fas fa-user-tie text-gold"></i>
                                                </div>
                                                <div>
                                                    <strong class="text-white fs-5">@trainer.Name</strong>
                                                    <br />
                                                    <small class="text-white-50">ID: @trainer.Id</small>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="py-4">
                                            <div class="text-white">@trainer.Email</div>
                                            <small class="text-white-50">@trainer.PhoneNumber</small>
                                        </td>
                                        <td class="py-4">
                                            <span class="badge bg-gold text-dark px-3 py-2 fw-medium">
                                                @trainer.Specialization
                                            </span>
                                        </td>
                                        <td class="text-white py-4">
                                            <strong>@trainer.ExperienceYears</strong> years
                                        </td>
                                        <td class="py-4">
                                            <div class="text-gold fw-bold fs-4">@trainer.MemberCount</div>
                                            <small class="text-white-50">active clients</small>
                                        </td>
                                        <td class="text-white py-4">@trainer.BranchName</td>
                                        <td class="py-4">
                                            @if (trainer.IsActive)
                                            {
                                                <span class="badge bg-success px-4 py-2 fs-6">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-secondary px-4 py-2 fs-6">Inactive</span>
                                            }
                                        </td>
                                        <td class="text-center pe-5 py-4">
                                            <div class="btn-group" role="group">
                                                <a asp-action="Edit" asp-route-id="@trainer.Id"
                                                   class="btn btn-outline-gold btn-sm rounded-pill px-4 me-2" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <form asp-action="ToggleStatus" asp-route-id="@trainer.Id" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <button type="submit" class="btn btn-sm rounded-pill @(trainer.IsActive ? "btn-danger" : "btn-success") px-4"
                                                            title="@(trainer.IsActive ? "Deactivate" : "Activate")">
                                                        <i class="fas fa-power-off"></i>
                                                    </button>
                                                </form>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Add Trainer Modal (Premium Styled) -->
<div class="modal fade" id="addTrainerModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-gold" style="border: 2px solid #d4af37; border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold fs-4">
                    <i class="fas fa-user-tie text-gold me-3"></i> Add New Elite Trainer
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body pt-4">
                <form id="addTrainerForm">
                    @Html.AntiForgeryToken()
                    <div class="row g-4">
                        <div class="col-md-6">
                            <label class="form-label text-white-70 fw-medium">First Name *</label>
                            <input type="text" class="form-control form-control-lg rounded-pill" name="firstName" placeholder="John" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-70 fw-medium">Last Name *</label>
                            <input type="text" class="form-control form-control-lg rounded-pill" name="lastName" placeholder="Doe" required>
                        </div>
                    </div>
                    <div class="row g-4 mt-2">
                        <div class="col-md-6">
                            <label class="form-label text-white-70 fw-medium">Email Address *</label>
                            <input type="email" class="form-control form-control-lg rounded-pill" name="email" placeholder="john.doe@gymfit.com" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-70 fw-medium">Phone Number *</label>
                            <input type="tel" class="form-control form-control-lg rounded-pill" name="phoneNumber" placeholder="+1 (555) 123-4567" required>
                        </div>
                    </div>
                    <div class="mt-4">
                        <label class="form-label text-white-70 fw-medium">Specialization *</label>
                        <input type="text" class="form-control form-control-lg rounded-pill" name="specialization" placeholder="e.g., Strength Training, Yoga, HIIT" required>
                    </div>
                    <div class="row g-4 mt-4">
                        <div class="col-md-6">
                            <label class="form-label text-white-70 fw-medium">Experience (Years) *</label>
                            <input type="number" class="form-control form-control-lg rounded-pill" name="experienceYears" min="0" placeholder="10" required>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label text-white-70 fw-medium">Initial Password *</label>
                            <input type="password" class="form-control form-control-lg rounded-pill" name="password" placeholder="••••••••" required>
                        </div>
                    </div>
                    <div class="mt-4">
                        <label class="form-label text-white-70 fw-medium">Certifications (optional)</label>
                        <textarea class="form-control rounded-3" style="background: #1a1a1a; border: 1px solid #444; color: #fff;" name="certifications" rows="3" placeholder="NASM-CPT, CSCS, Yoga Alliance RYT-500..."></textarea>
                    </div>
                    <div class="mt-4">
                        <label class="form-label text-white-70 fw-medium">Bio (optional)</label>
                        <textarea class="form-control rounded-3" style="background: #1a1a1a; border: 1px solid #444; color: #fff;" name="bio" rows="4" placeholder="Brief professional background and coaching philosophy..."></textarea>
                    </div>
                </form>
            </div>
            <div class="modal-footer border-0 pt-4 justify-content-center">
                <button type="button" class="btn btn-outline-light px-5 me-3" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" form="addTrainerForm" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold">
                    <i class="fas fa-user-plus me-2"></i> Add Trainer
                </button>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #d4af37 !important;
    }

    .bg-gold {
        background-color: #d4af37 !important;
    }

    .btn-gold {
        background-color: #d4af37;
        color: #121212;
        border: none;
        font-weight: 700;
        transition: all 0.4s ease;
    }

        .btn-gold:hover {
            background-color: #c19a2b;
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(212,175,55,0.4);
        }

    .btn-outline-gold {
        border: 2px solid #d4af37;
        color: #d4af37;
        background: transparent;
        transition: all 0.3s ease;
    }

        .btn-outline-gold:hover {
            background-color: #d4af37;
            color: #121212;
            transform: translateY(-2px);
        }

    .text-white-70 {
        color: rgba(255,255,255,0.7);
    }

    .text-white-60 {
        color: rgba(255,255,255,0.6);
    }

    .text-white-50 {
        color: rgba(255,255,255,0.5);
    }

    .avatar-circle {
        width: 60px;
        height: 60px;
        background: rgba(212,175,55,0.15);
        border: 2px solid #d4af37;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.5rem;
    }

    .premium-shadow {
        box-shadow: 0 15px 50px rgba(0,0,0,0.7);
    }

    .shadow-gold {
        box-shadow: 0 10px 30px rgba(212,175,55,0.4);
    }

    .table tbody tr:hover {
        background: rgba(212,175,55,0.08) !important;
        transform: translateY(-2px);
    }

    .card-header {
        background: linear-gradient(135deg, #1e1e1e, #121212) !important;
    }

    .badge {
        font-size: 0.9rem;
    }

    .border-gold {
        border-color: #d4af37 !important;
    }

    .form-control:focus, .form-select:focus {
        border-color: #d4af37;
        box-shadow: 0 0 0 0.2rem rgba(212,175,55,0.25);
    }
</style>

@section Scripts {
    <script>
        $('#addTrainerForm').on('submit', function (e) {
            e.preventDefault();
            const btn = $(this).closest('.modal').find('button[type="submit"]');
            const original = btn.html();
            btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> Adding...');

            // You'll need to adjust the URL and data mapping to match your backend
            $.ajax({
                url: '@Url.Action("Create", "Trainers")'
                type: 'POST',
                data: $(this).serialize(),
                success: function (response) {
                    if (response.success) {
                        showToast('success', response.message || 'New trainer added successfully!');
                        $('#addTrainerModal').modal('hide');
                        $('#addTrainerForm')[0].reset();
                        location.reload(); // Or implement dynamic reload
                    } else {
                        showToast('error', response.message || 'Failed to add trainer');
                    }
                    btn.prop('disabled', false).html(original);
                },
                error: function () {
                    showToast('error', 'Network error. Please try again.');
                    btn.prop('disabled', false).html(original);
                }
            });
        });
    </script>
}