@model IReadOnlyList<GymFit.Domain.Entities.Attendance>
@{ ViewData["Title"] = "My Attendance"; }
<div class="container py-5"><h1 class="display-6 fw-bold mb-4">My attendance</h1><div class="card shadow-sm"><div class="table-responsive"><table class="table table-hover mb-0"><thead><tr><th>Check-in</th><th>Check-out</th><th>Duration</th></tr></thead><tbody>@if(Model.Count == 0){<tr><td colspan="3" class="text-center py-4">No attendance records are available.</td></tr>}@foreach(var record in Model){<tr><td>@record.CheckInTime.ToLocalTime().ToString("dd MMM yyyy, HH:mm")</td><td>@(record.CheckOutTime?.ToLocalTime().ToString("dd MMM yyyy, HH:mm") ?? "Active")</td><td>@(record.CheckOutTime.HasValue ? (record.CheckOutTime.Value - record.CheckInTime).TotalMinutes.ToString("0") + " mins" : "—")</td></tr>}</tbody></table></div></div></div>
