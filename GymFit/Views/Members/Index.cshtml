@using GymFit.Application.DTOs
@model IEnumerable<MemberDto>
@{
    ViewData["Title"] = "Members List";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}

<section class="py-5" style="background: linear-gradient(to bottom, #121212, #1a1a1a); min-height: 100vh;">
    <div class="container py-5">
        <!-- Header -->
        <div class="row mb-5">
            <div class="col-lg-12 text-center">
                <h1 class="display-4 fw-bold text-white mb-3">
                    Elite <span class="text-gold">Members</span>
                </h1>
                <p class="lead text-white-60">
                    Managing our exclusive community of dedicated athletes
                </p>
            </div>
        </div>

        <!-- Card -->
        <div class="card premium-shadow rounded-4 overflow-hidden"
             style="background: #1a1a1a; border: 1px solid #333;">
            <!-- Card Header -->
            <div class="card-header py-4 px-5 d-flex justify-content-between align-items-center"
                 style="background: #121212; border-bottom: 1px solid #333;">
                <div>
                    <h3 class="h4 fw-bold text-white mb-0">Member Directory</h3>
                    <p class="text-white-60 mb-0 mt-1">
                        Total Elite Members:
                        <strong class="text-gold">@Model.Count()</strong>
                    </p>
                </div>
                <button type="button" class="btn btn-gold btn-lg px-5 py-3 rounded-pill shadow-gold" data-bs-toggle="modal" data-bs-target="#addMemberModal">
                    <i class="fas fa-user-plus me-2"></i> Add New Member
                </button>
            </div>

            <!-- Card Body -->
            <div class="card-body p-0">
                @if (!Model.Any())
                {
                    <div class="text-center py-5">
                        <i class="fas fa-users fa-4x text-white-30 mb-4"></i>
                        <p class="text-white-60 fs-5">No elite members found in the community yet.</p>
                    </div>
                }
                else
                {
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0" id="membersTable">
                            <thead style="background: rgba(212,175,55,0.05);">
                                <tr>
                                    <th class="text-white fw-bold ps-5">Member</th>
                                    <th class="text-white fw-bold">Contact</th>
                                    <th class="text-white fw-bold">Address</th>
                                    <th class="text-white fw-bold">Joined</th>
                                    <th class="text-white fw-bold">Status</th>
                                    <th class="text-white fw-bold">Trainer</th>
                                    <th class="text-white fw-bold text-center pe-5">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var member in Model)
                                {
                                    <tr class="border-bottom border-dark">
                                        <!-- Member -->
                                        <td class="ps-5 py-4">
                                            <div class="d-flex align-items-center">
                                                <div class="avatar-circle me-3">
                                                    <i class="fas fa-user text-gold"></i>
                                                </div>
                                                <div>
                                                    <strong class="text-white">
                                                        @member.FirstName @member.LastName
                                                    </strong>
                                                    <br />
                                                    <small class="text-white-50">
                                                        ID: @member.Id
                                                    </small>
                                                </div>
                                            </div>
                                        </td>
                                        <!-- Contact -->
                                        <td class="py-4">
                                            <div class="text-white">@member.Email</div>
                                            <small class="text-white-50">@member.PhoneNumber</small>
                                        </td>
                                        <!-- Address -->
                                        <td class="py-4">
                                            <div class="text-white fw-medium">@member.Address</div>
                                        </td>
                                        <!-- Joined -->
                                        <td class="text-white py-4">
                                            @member.JoinDate.ToString("MMM dd, yyyy")
                                        </td>
                                        <!-- Status -->
                                        <td class="py-4">
                                            @if (member.IsActive)
                                            {
                                                <span class="badge bg-success px-3 py-2">Active</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-danger px-3 py-2">Inactive</span>
                                            }
                                        </td>
                                        <!-- Trainer -->
                                        <td class="text-white py-4">
                                            @(string.IsNullOrEmpty(member.AssignedTrainerName) ?
                                                "<em class='text-white-50'>Unassigned</em>" :
                                                member.AssignedTrainerName)
                                        </td>
                                        <!-- Actions -->
                                        <td class="text-center pe-5 py-4">
                                            <div class="btn-group" role="group">
                                                <a asp-action="Details" asp-route-id="@member.Id"
                                                   class="btn btn-outline-gold btn-sm rounded-pill px-3" title="View">
                                                    <i class="fas fa-eye"></i>
                                                </a>
                                                <a asp-action="Edit" asp-route-id="@member.Id"
                                                   class="btn btn-outline-gold btn-sm rounded-pill px-3" title="Edit">
                                                    <i class="fas fa-edit"></i>
                                                </a>
                                                <a asp-action="Delete" asp-route-id="@member.Id"
                                                   class="btn btn-outline-danger btn-sm rounded-pill px-3" title="Delete">
                                                    <i class="fas fa-trash"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
            </div>
        </div>
    </div>
</section>

<!-- Add Member Modal -->
<div class="modal fade" id="addMemberModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content bg-dark border-gold" style="border: 2px solid #d4af37; border-radius: 20px;">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title text-white fw-bold fs-4">
                    <i class="fas fa-user-plus text-gold me-3"></i> Add New Elite Member
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body py-5 text-center">
                <i class="fas fa-user-plus fa-4x text-gold mb-4"></i>
                <h4 class="text-white">Create a member account</h4>
                <p class="text-white-60">Create the member profile and login credentials in one secure workflow.</p>
                <a asp-action="Create" class="btn btn-gold px-5">Continue</a>
            </div>
            <div class="modal-footer border-0 justify-content-center">
                <button type="button" class="btn btn-outline-light px-5" data-bs-dismiss="modal">Close</button>
            </div>
        </div>
    </div>
</div>

<style>
    .text-gold {
        color: #d4af37 !important;
    }

    .bg-gold {
        background-color: #d4af37 !important;
    }

    .btn-gold {
        background-color: #d4af37;
        color: #121212;
        border: none;
        font-weight: 700;
        transition: all 0.4s ease;
    }

        .btn-gold:hover {
            background-color: #c19a2b;
            transform: translateY(-4px);
            box-shadow: 0 15px 35px rgba(212,175,55,0.4);
        }

    .btn-outline-gold {
        border: 2px solid #d4af37;
        color: #d4af37;
        background: transparent;
        transition: all 0.3s ease;
    }

        .btn-outline-gold:hover {
            background-color: #d4af37;
            color: #121212;
        }

    .btn-outline-danger {
        border: 2px solid #dc3545;
        color: #dc3545;
    }

        .btn-outline-danger:hover {
            background-color: #dc3545;
            color: #fff;
        }

    .text-white-60 {
        color: rgba(255,255,255,0.6);
    }

    .text-white-50 {
        color: rgba(255,255,255,0.5);
    }

    .avatar-circle {
        width: 50px;
        height: 50px;
        background: rgba(212,175,55,0.15);
        border: 2px solid #d4af37;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
    }

    .premium-shadow {
        box-shadow: 0 10px 40px rgba(0,0,0,0.6);
    }

    .shadow-gold {
        box-shadow: 0 10px 30px rgba(212,175,55,0.4);
    }

    .table tbody tr:hover {
        background: rgba(212,175,55,0.08) !important;
    }
</style>

@section Scripts {
    <link rel="stylesheet"
          href="https://cdn.datatables.net/1.13.7/css/dataTables.bootstrap5.min.css" />
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/dataTables.bootstrap5.min.js"></script>
    <script>
        $(document).ready(function () {
            $('#membersTable').DataTable({
                pageLength: 25,
                order: [[3, 'desc']], // Sort by Join Date descending
                columnDefs: [
                    { orderable: false, targets: 6 } // Disable sorting on Actions
                ],
                language: {
                    search: "Search elite members:",
                    info: "Showing _START_ to _END_ of _TOTAL_ members"
                }
            });
        });
    </script>
}