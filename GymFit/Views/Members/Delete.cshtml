@model GymFit.Application.DTOs.MemberDto
@{ ViewData["Title"] = "Delete Member"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<div class="container py-5"><div class="card card-body shadow-sm"><h1 class="h3">Delete member?</h1><p>Deactivate <strong>@Model.FirstName @Model.LastName</strong>? Existing records will be retained.</p><form asp-action="Delete" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@Model.Id" /><button class="btn btn-danger">Deactivate member</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></form></div></div>
