@model GymFit.Application.ViewModels.MemberViewModel
@{ ViewData["Title"] = "Edit Member"; Layout = "~/Views/Shared/_AdminLayout.cshtml"; }
<div class="container py-4"><h1 class="h2 mb-4">Edit member</h1><form id="editMemberForm" asp-action="Edit" method="post" class="card card-body shadow-sm">@Html.AntiForgeryToken()<input asp-for="Id" type="hidden" /><div class="row g-3"><div class="col-md-6"><label asp-for="FirstName" class="form-label"></label><input asp-for="FirstName" class="form-control" /></div><div class="col-md-6"><label asp-for="LastName" class="form-label"></label><input asp-for="LastName" class="form-control" /></div><div class="col-md-6"><label asp-for="Email" class="form-label"></label><input asp-for="Email" class="form-control" readonly /></div><div class="col-md-6"><label asp-for="PhoneNumber" class="form-label"></label><input asp-for="PhoneNumber" class="form-control" /></div><div class="col-12"><label asp-for="Address" class="form-label"></label><textarea asp-for="Address" class="form-control"></textarea></div><div class="col-md-6"><label asp-for="EmergencyContact" class="form-label"></label><input asp-for="EmergencyContact" class="form-control" /></div><div class="col-md-6"><label asp-for="MedicalConditions" class="form-label"></label><input asp-for="MedicalConditions" class="form-control" /></div><div class="col-md-6"><label asp-for="PrimaryBranchId" class="form-label"></label><select asp-for="PrimaryBranchId" class="form-select" required><option value="">Select branch</option>@foreach (var branch in ViewBag.Branches) {<option value="@branch.Id">@branch.Name (@branch.Code)</option>}</select></div></div><div class="mt-4"><button class="btn btn-danger">Save changes</button> <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a></div></form></div>
@section Scripts { <script>$('#editMemberForm').on('submit', function (event) { event.preventDefault(); ajaxHelper.post('@Url.Action("Edit", "Members")', $(this).serialize(), function (response) { if (response.success) window.location.href = '@Url.Action("Index", "Members")'; else showToast('error', response.message || 'Unable to save changes.'); }); });</script> }
