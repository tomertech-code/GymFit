@{
    ViewData["Title"] = "About Us";
}
<section class="page-header position-relative overflow-hidden py-5" style="background: linear-gradient(135deg, #121212 0%, #1e1e1e 100%);">
    <div class="container position-relative py-5">
        <div class="text-center">
            <h1 class="display-3 fw-bold text-white">About <span class="text-gold">GymFit</span></h1>
            <p class="lead text-white-60 fs-4">Your gateway to elite fitness and unparalleled transformation</p>
        </div>
    </div>
</section>

<section class="py-5" style="background: linear-gradient(to bottom, #121212, #1a1a1a);">
    <div class="container py-5">
        <div class="row align-items-center mb-5 g-5">
            <div class="col-lg-6">
                <h2 class="display-4 fw-bold text-white mb-4">Our <span class="text-gold">Legacy</span></h2>
                <p class="lead text-white-70 mb-4">
                    Founded in 2020, GymFit has rapidly established itself as the pinnacle of luxury fitness destinations.
                    We go beyond mere physical training—delivering a holistic lifestyle of peak performance, wellness, and exclusivity.
                </p>
                <p class="text-white-60 mb-5">
                    Our expansive 15,000+ square foot facility boasts cutting-edge equipment, meticulously designed spaces, and world-class amenities.
                    From aspiring beginners to elite athletes, we provide an environment engineered for extraordinary results.
                </p>
                <a href="/Home/Plans" class="btn btn-gold btn-lg px-6 py-3 rounded-pill shadow-gold">
                    <i class="fas fa-crown me-2"></i> <strong>Join the Elite</strong>
                </a>
            </div>
            <div class="col-lg-6">
                <div class="row g-4">
                    <div class="col-6">
                        <img src="http://www.pentfitness.com/cdn/shop/files/ATE_P15_Home_gym_prev01_HR.jpg?v=1693677814" alt="Premium Luxury Fitness Equipment" class="img-fluid rounded-4 premium-shadow" style="height: 300px; object-fit: cover;" />
                    </div>
                    <div class="col-6">
                        <img src="https://images.squarespace-cdn.com/content/v1/5696733025981d28a35ef8ab/1ac027c0-cae1-4d8a-9e58-32a8ad92680a/Fusion+BRB+cardio+room+BIOFIT+V3.jpeg" alt="Elegant Cardio Area in Luxury Gym" class="img-fluid rounded-4 premium-shadow" style="height: 300px; object-fit: cover;" />
                    </div>
                    <div class="col-6">
                        <img src="https://cdn.prod.website-files.com/65d7b904c0af185c6d721f6f/66745b16786e4667065274df_Friends-Taking-Fitness-Class-NewYorkCity.webp" alt="Dynamic Group Fitness Class" class="img-fluid rounded-4 premium-shadow" style="height: 300px; object-fit: cover;" />
                    </div>
                    <div class="col-6">
                        <img src="http://www.pentfitness.com/cdn/shop/collections/Projekt_14_Hotel_gym_HR_1_c12362db-bb62-4dfd-a31b-e72a9616255c.jpg?v=1696761769" alt="Sophisticated Hotel-Style Gym Design" class="img-fluid rounded-4 premium-shadow" style="height: 300px; object-fit: cover;" />
                    </div>
                </div>
            </div>
        </div>

        <div class="row mb-5 g-5 justify-content-center">
            <div class="col-md-3 text-center">
                <div class="stats-box p-4 rounded-4 premium-shadow">
                    <h2 class="display-3 fw-bold text-gold mb-2">500+</h2>
                    <p class="text-white-70 fs-5">Elite Members</p>
                </div>
            </div>
            <div class="col-md-3 text-center">
                <div class="stats-box p-4 rounded-4 premium-shadow">
                    <h2 class="display-3 fw-bold text-gold mb-2">20+</h2>
                    <p class="text-white-70 fs-5">World-Class Trainers</p>
                </div>
            </div>
            <div class="col-md-3 text-center">
                <div class="stats-box p-4 rounded-4 premium-shadow">
                    <h2 class="display-3 fw-bold text-gold mb-2">50+</h2>
                    <p class="text-white-70 fs-5">Signature Classes Weekly</p>
                </div>
            </div>
            <div class="col-md-3 text-center">
                <div class="stats-box p-4 rounded-4 premium-shadow">
                    <h2 class="display-3 fw-bold text-gold mb-2">5+</h2>
                    <p class="text-white-70 fs-5">Years of Excellence</p>
                </div>
            </div>
        </div>

        <div class="row g-5">
            <div class="col-lg-12 text-center mb-5">
                <h2 class="display-4 fw-bold text-white">Our <span class="text-gold">Core Values</span></h2>
            </div>
            <div class="col-md-4">
                <div class="value-card text-center p-5 rounded-4 h-100 premium-shadow" style="transition: all 0.4s ease;">
                    <div class="icon-circle mb-4 mx-auto">
                        <i class="fas fa-heart fa-2x text-gold"></i>
                    </div>
                    <h3 class="h4 fw-bold text-white mb-3">Passion</h3>
                    <p class="text-white-60">Fueled by an unwavering dedication to fitness and the success of every member. Each session is infused with authentic commitment and expertise.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card text-center p-5 rounded-4 h-100 premium-shadow" style="transition: all 0.4s ease;">
                    <div class="icon-circle mb-4 mx-auto">
                        <i class="fas fa-trophy fa-2x text-gold"></i>
                    </div>
                    <h3 class="h4 fw-bold text-white mb-3">Excellence</h3>
                    <p class="text-white-60">Uncompromising standards in equipment, training, facilities, and service—delivering nothing short of extraordinary.</p>
                </div>
            </div>
            <div class="col-md-4">
                <div class="value-card text-center p-5 rounded-4 h-100 premium-shadow" style="transition: all 0.4s ease;">
                    <div class="icon-circle mb-4 mx-auto">
                        <i class="fas fa-users fa-2x text-gold"></i>
                    </div>
                    <h3 class="h4 fw-bold text-white mb-3">Community</h3>
                    <p class="text-white-60">A supportive network of like-minded individuals who inspire, motivate, and elevate one another toward greatness.</p>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .text-gold {
        color: #d4af37;
    }

    .text-white-70 {
        color: rgba(255,255,255,0.7);
    }

    .text-white-60 {
        color: rgba(255,255,255,0.6);
    }

    .btn-gold {
        background-color: #d4af37;
        color: #121212;
        border: none;
        font-weight: 700;
        transition: all 0.4s ease;
    }

        .btn-gold:hover {
            background-color: #c19a2b;
            transform: translateY(-4px);
        }

    .stats-box {
        background: rgba(26,26,26,0.8);
        backdrop-filter: blur(10px);
        border: 1px solid #333;
    }

        .stats-box:hover {
            transform: translateY(-10px);
        }

    .value-card {
        background: #1a1a1a;
        border: 1px solid #333;
    }

        .value-card:hover {
            transform: translateY(-15px);
            box-shadow: 0 20px 40px rgba(212,175,55,0.2);
            border-color: #d4af37;
        }

    .icon-circle {
        width: 100px;
        height: 100px;
        background: rgba(212,175,55,0.15);
        border: 2px solid #d4af37;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .premium-shadow {
        box-shadow: 0 10px 40px rgba(0,0,0,0.5);
    }

    .shadow-gold {
        box-shadow: 0 10px 30px rgba(212,175,55,0.4);
    }
</style>