@model IReadOnlyList<GymFit.Domain.Entities.UserNotification>
@{ViewData["Title"]="Notifications";}
<div class="container py-4">@if(User.IsInRole("Admin")){var users=ViewBag.Users as IEnumerable<GymFit.Domain.Entities.ApplicationUser> ?? Array.Empty<GymFit.Domain.Entities.ApplicationUser>();<div class="card shadow-sm mb-4"><div class="card-body"><h2 class="h5">Send notification</h2><form asp-action="Create" method="post">@Html.AntiForgeryToken()<div class="row g-2"><div class="col-md-3"><select class="form-select" name="userId" required><option value="">Select user</option>@foreach(var x in users){<option value="@x.Id">@x.FirstName @x.LastName (@x.Email)</option>}</select></div><div class="col-md-2"><input class="form-control" name="title" maxlength="200" placeholder="Title" required/></div><div class="col-md-4"><input class="form-control" name="message" maxlength="2000" placeholder="Message" required/></div><div class="col-md-2"><input class="form-control" name="url" maxlength="500" placeholder="Optional URL"/></div><div class="col-md-1"><button class="btn btn-danger w-100">Send</button></div></div></form></div></div>}<div class="d-flex justify-content-between align-items-center mb-4"><div><h1 class="h2">Notifications</h1><p class="text-muted">Your GymFit updates and reminders.</p></div><form asp-action="MarkAllRead" method="post">@Html.AntiForgeryToken()<button class="btn btn-outline-dark">Mark all read</button></form></div><div class="list-group shadow-sm">@foreach(var n in Model){<div class="list-group-item @(n.IsRead?"":"list-group-item-warning")"><div class="d-flex justify-content-between"><div><strong>@n.Title</strong><p class="mb-1">@n.Message</p><small class="text-muted">@n.CreatedAt.ToLocalTime().ToString("dd MMM yyyy, hh:mm tt")</small></div>@if(!n.IsRead){<form asp-action="MarkRead" method="post">@Html.AntiForgeryToken()<input type="hidden" name="id" value="@n.Id"/><button class="btn btn-sm btn-outline-success">Mark read</button></form>}</div></div>}@if(!Model.Any()){<div class="list-group-item text-center text-muted py-5">No notifications.</div>}</div></div>
